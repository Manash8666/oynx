# ==============================================================================
# Onyx Engineering Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure in your deployment environment.
# All variables have deterministic, safe fallbacks in local development.
# ==============================================================================

# --- Server & Network ---
# The local port for Onyx Unified Dev Server (Fallback: 3000)
PORT=3000
# Server host interface (Fallback: localhost or 0.0.0.0)
HOST=localhost
# Client and SPA Base URL (Fallback: http://localhost:3000)
BASE_URL=http://localhost:3000
# Cloud API Gateway Origin (Fallback: https://app.oynx.si)
KILO_API_URL=https://app.oynx.si

# --- Bring-Your-Own-AI (BYOAI) Keys ---
# Local Ollama endpoint (Fallback: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
# Optional provider API keys for hosted inference (Fallback: local mock / air-gapped mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
NVIDIA_NIM_API_KEY=

# --- Enterprise Storage & MicroVM Sandboxes ---
# SQLite / Embedded Channel DB path (Fallback: in-memory / local state)
KILO_DB=:memory:
# Disable background channel telemetry in offline dev (Fallback: true)
KILO_DISABLE_CHANNEL_DB=true
# Ephemeral MicroVM cold-boot memory in MB (Fallback: 512)
MICROVM_MEMORY_MB=512

# --- Observability & Telemetry ---
# OpenTelemetry OTLP Collector Endpoint (Fallback: undefined / disabled)
OTEL_EXPORTER_OTLP_ENDPOINT=
# OpenTelemetry Resource Attributes (Fallback: service.name=onyx-platform)
OTEL_RESOURCE_ATTRIBUTES=service.name=onyx-platform
# Logging level: DEBUG, INFO, WARN, ERROR (Fallback: INFO)
KILO_LOG_LEVEL=INFO
# Print internal engine logs to console (Fallback: 0)
KILO_PRINT_LOGS=0

# --- CI & Test Automation ---
# Flag indicating CI runner environment (Fallback: false)
CI=false
