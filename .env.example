# ==============================================================================
# Onyx Autonomous Engineering Platform (.env.example)
# Domain: https://oynx.si | App Console: https://app.oynx.si
# ==============================================================================
# Copy this file to .env or inject into your cloud / container environment.
# All variables support ONYX_* and OYNX_* namespaces with zero-telemetry local defaults.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Onyx & Oynx Network Infrastructure & Domains
# ------------------------------------------------------------------------------
# The primary local server port (Default: 3000)
ONYX_PORT=3000
PORT=3000

# The server host binding interface (Default: localhost)
ONYX_HOST=localhost
HOST=localhost

# Canonical production marketing domain & website origin
OYNX_DOMAIN=oynx.si
OYNX_WEB_URL=https://oynx.si
ONYX_BASE_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# Cloud IDE Workbench & API Gateway Origin
OYNX_APP_URL=https://app.oynx.si
ONYX_API_URL=https://app.oynx.si
# Legacy fallback alias
KILO_API_URL=https://app.oynx.si

# ------------------------------------------------------------------------------
# 2. Agent Lucifer Quad-Cortex Engine Configuration
# ------------------------------------------------------------------------------
# Cortex 1: High-Order Analytical & Reasoning Model (Default: deepseek-r1:latest)
ONYX_LUCIFER_REASONING_MODEL=deepseek-r1:latest

# Cortex 2: Multimodal UI & Design System Model (Default: qwen2.5-coder:32b)
ONYX_LUCIFER_CODING_MODEL=qwen2.5-coder:32b

# Cortex 3: Step-Level Process Reward Model (PRM)
ONYX_LUCIFER_PRM_MODEL=nemotron-prm:latest

# Cortex 4: Quantitative & Formal Mathematics Engine (true/false)
ONYX_QUANT_MATH_ENABLED=true

# Multi-Agent Autonomous Swarm Coordinator (true/false)
ONYX_AGENT_SWARM_ENABLED=true

# In-Process Tree-Sitter AST Compiler Guard (strict/permissive)
ONYX_AST_STRICT_MODE=true

# Strict Air-Gapped Mode: disables all phone-home requests, 100% offline
ONYX_AIRGAPPED_MODE=false

# Ephemeral Firecracker MicroVM RAM allocation in MB (Default: 512)
ONYX_MICROVM_MEMORY_MB=512
MICROVM_MEMORY_MB=512

# ------------------------------------------------------------------------------
# 3. Bring-Your-Own-AI (BYOAI) & Local Inference Gateways
# ------------------------------------------------------------------------------
# Local Ollama endpoint for 100% offline zero-marginal-cost inference
OLLAMA_HOST=http://localhost:11434

# Optional direct provider API keys for hosted inference ($0 platform markup)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
NVIDIA_NIM_API_KEY=

# ------------------------------------------------------------------------------
# 4. Enterprise Data Storage, State & Git Checkpoints
# ------------------------------------------------------------------------------
# Embedded SQLite state & channel DB path (Use :memory: for dev/tests)
ONYX_DB=:memory:
KILO_DB=:memory:

# Disable background channel telemetry in local development (Default: true)
ONYX_DISABLE_CHANNEL_DB=true
KILO_DISABLE_CHANNEL_DB=true

# Active Onyx Organization & Workspace ID
ONYX_WORKSPACE_ID=onyx-default
ONYX_ORG_ID=onyx-enterprise-tier

# ------------------------------------------------------------------------------
# 5. Observability, Structured Logging & Telemetry
# ------------------------------------------------------------------------------
# OpenTelemetry OTLP Collector Endpoint (Optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
# OpenTelemetry Resource Attributes
OTEL_RESOURCE_ATTRIBUTES=service.name=onyx-platform

# Logging verbosity level: DEBUG, INFO, WARN, ERROR (Default: INFO)
ONYX_LOG_LEVEL=INFO
KILO_LOG_LEVEL=INFO

# Print engine logs to stderr (0 = quiet, 1 = verbose)
ONYX_PRINT_LOGS=0
KILO_PRINT_LOGS=0

# ------------------------------------------------------------------------------
# 6. CI & Test Harness Automation
# ------------------------------------------------------------------------------
# Set to true in CI pipelines (GitHub Actions, GitLab CI, Vercel)
CI=false
